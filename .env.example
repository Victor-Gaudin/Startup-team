# Copy to .env and fill in. Never commit .env.

# --- Claude (listing copy + product research) ---
ANTHROPIC_API_KEY=
DROPKIT_MODEL=claude-opus-5-5

# --- eBay developer app (https://developer.ebay.com/my/keys) ---
EBAY_ENV=sandbox                 # sandbox | production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=                    # "RuName" redirect URL name from the eBay dev portal
EBAY_MARKETPLACE=EBAY_US         # EBAY_US | EBAY_GB | EBAY_FR | EBAY_DE
EBAY_MERCHANT_LOCATION_KEY=default
# Business policy IDs (Seller Hub > Account > Business policies), or run `dropkit ebay-policies`
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# --- AliExpress Open Platform, Dropshipping API (optional, enables auto-order) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=

# --- Pricing defaults ---
DROPKIT_TARGET_MARGIN=0.20       # net margin you want on each sale (0.20 = 20%)
DROPKIT_MIN_MARGIN=0.10          # monitor pauses a listing below this
DROPKIT_PROMOTED_RATE=0.04       # Promoted Listings ad rate
DROPKIT_FX_RATE=1.0              # supplier currency -> marketplace currency

# --- Scraping (optional) ---
# HTTP(S) proxy used only for supplier page fetches, e.g. an OxyLabs endpoint
DROPKIT_SCRAPER_PROXY=

DROPKIT_DB=dropkit.db
